# Portal de guías — protecciones básicas (Apache / LiteSpeed)
Options -Indexes
DirectoryIndex index.php

# Bloquea archivos de configuración, datos y documentación.
<FilesMatch "^(config(\.example)?\.php|LEEME\.md|\.gitignore)$|\.(json|csv|key|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
